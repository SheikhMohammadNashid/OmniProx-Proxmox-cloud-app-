#cloud-config
# Copy to your Proxmox node as:
#   /var/lib/vz/snippets/enable-ssh-password.yaml
# (Must match cicustom in the app: vendor=local:snippets/enable-ssh-password.yaml)
#
# qemu-guest-agent is required for the portal to read the VM IP from Proxmox.

ssh_pwauth: true

write_files:
  - path: /etc/ssh/sshd_config.d/60-password-auth.conf
    content: |
      PasswordAuthentication yes
    permissions: "0644"

packages:
  - qemu-guest-agent

runcmd:
  - systemctl enable --now qemu-guest-agent
  - test -d /run/systemd/system && systemctl try-reload-or-restart ssh || systemctl try-reload-or-restart sshd || true
